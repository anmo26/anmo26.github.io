# .DS_Store holds the Finder layout, but the positions are already baked into
# the generated HTML — no need to publish the metadata itself.
.DS_Store
node_modules/
*.log

# the compiled icon helper and its cache — rebuilt on demand, never published
.garden-cache/

# The full-quality photos, kept after conversion. Big, and the site never
# points at them, so they stay out of the repo.
.originals/

# .thumbs/ is deliberately NOT ignored. The page points at it, so a visitor
# gets a broken image if it is not published -- and a thumbnail that only
# exists on this Mac makes nothing faster for anyone.
